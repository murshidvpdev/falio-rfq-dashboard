# ─────────────────────────────────────────────────────────────────────────────
# RFQ Dashboard — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=rfq
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=rfq_dashboard

# ── Backend / JWT ─────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_64_char_random_hex_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Frontend Build ────────────────────────────────────────────────────────────
# Leave blank when nginx is the single entry point (it proxies internally).
# Set to a full URL only when the backend is on a different host/port.
VITE_API_BASE_URL=
VITE_WS_BASE_URL=

# ── Docker Compose ────────────────────────────────────────────────────────────
FRONTEND_PORT=80
